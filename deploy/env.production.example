# =============================================================================
# TIMALOVE — variables d'environnement PRODUCTION
# Copier vers : /home/colobanes/timalove.goo-bridge.com/timalove/.env
#   cp deploy/env.production.example timalove/.env
#   nano timalove/.env
# Ne jamais committer ce fichier une fois rempli.
# =============================================================================

SECRET_KEY=REMPLACER-PAR-UNE-CLE-LONGUE-ALEATOIRE
DEBUG=False
ALLOWED_HOSTS=timalove.goo-bridge.com,www.timalove.goo-bridge.com,127.0.0.1
SITE_URL=https://timalove.goo-bridge.com
CSRF_TRUSTED_ORIGINS=https://timalove.goo-bridge.com,https://www.timalove.goo-bridge.com

# Mettre True seulement APRÈS que le SSL Let's Encrypt soit actif
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
USE_X_FORWARDED_HOST=True
SECURE_HSTS_SECONDS=0

# PostgreSQL Webuzo
DB_NAME=colobanes_timalove
DB_USER=colobanes_jomas
DB_PASSWORD=REMPLACER-MOT-DE-PASSE-POSTGRES
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis Webuzo (ajouter :password@ si Redis a un mot de passe)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
USE_REDIS_CHANNELS=True

MEDIA_ROOT=
MEDIA_URL=/media/

# CinetPay — coller les clés du back-office
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_CURRENCY=XOF
CINETPAY_CHANNELS=ALL
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
PAYMENT_SIMULATION=False

RESEND_API_KEY=
RESEND_FROM_EMAIL=TimaLove <noreply@timalove.goo-bridge.com>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

FCM_ENABLED=True
