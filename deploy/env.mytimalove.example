# =============================================================================
# TIMALOVE — variables PRODUCTION (mytimalove.com)
# Généré / rempli par deploy/install-vps.sh → timalove/.env
# Ne jamais committer ce fichier une fois rempli.
# =============================================================================

SECRET_KEY=REMPLACER-PAR-UNE-CLE-LONGUE-ALEATOIRE
DEBUG=False
ALLOWED_HOSTS=mytimalove.com,www.mytimalove.com,127.0.0.1
SITE_URL=https://mytimalove.com
CSRF_TRUSTED_ORIGINS=https://mytimalove.com,https://www.mytimalove.com

# True seulement APRÈS certificat SSL actif (Certbot)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
USE_X_FORWARDED_HOST=True
SECURE_HSTS_SECONDS=0

# PostgreSQL local (créé par install-vps.sh)
DB_NAME=timalove
DB_USER=timalove
DB_PASSWORD=REMPLACER-MOT-DE-PASSE-POSTGRES
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis local — Channels + Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
USE_REDIS_CHANNELS=True

MEDIA_ROOT=
MEDIA_URL=/media/

FREEMIUM_LIMITS_ENABLED=True
PAYMENT_SIMULATION=False
PAYMENT_PROVIDER=naboopay
NABOOPAY_API_KEY=
NABOOPAY_WEBHOOK_SECRET=
NABOOPAY_BASE_URL=https://api.naboopay.com
NABOOPAY_CURRENCY=XOF
NABOOPAY_METHODS=wave,orange_money
NABOOPAY_FEES_CUSTOMER_SIDE=false
NABOOPAY_PRODUCTION_SITE_URL=https://mytimalove.com

CINETPAY_APIKEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=
CINETPAY_CURRENCY=XOF
CINETPAY_CHANNELS=ALL
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2

RESEND_API_KEY=
RESEND_FROM_EMAIL=TimaLove <service@timalove.goo-bridge.com>
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=timalove.goo-bridge.com
EMAIL_PORT=465
EMAIL_HOST_USER=service@timalove.goo-bridge.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=TimaLove <service@timalove.goo-bridge.com>

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

FCM_ENABLED=True
FIREBASE_CREDENTIALS_FILE=timalove-ddaa5-1ee274740c65.json
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=timalove-ddaa5.firebaseapp.com
FIREBASE_PROJECT_ID=timalove-ddaa5
FIREBASE_STORAGE_BUCKET=timalove-ddaa5.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_VAPID_KEY=
GOOGLE_WEB_CLIENT_ID=
